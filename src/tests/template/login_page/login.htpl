<div id="login-stpl" class="m-auto w-full h-full max-w-xs">
  <form class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
    <div class="mb-4">
      <label class="block text-gray-700 text-sm font-bold mb-2" for="username">
        Username
      </label>
      <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight
        focus:outline-none focus:shadow-outline"
        id="username"
        name="username"
        type="text"
        placeholder="Username"
        value=".username">
    </div>
    <div class="mb-6">
      <label class="block text-gray-700 text-sm font-bold mb-2" for="room-id">
        Room ID
      </label>
      <input
        class="shadow appearance-none border border-red-500 rounded w-full py-2 px-3 text-gray-700 mb-3
               leading-tight focus:outline-none focus:shadow-outline"
        id="room-id"
        type="number"
        name="room_id"
        placeholder="Room Id"
        value=".roomid">
      <p class="text-red-500 text-xs italic">Please choose a room id.</p>
    </div>
    <div class="flex items-center justify-between">
      <button
        hx-post="/pages/login/create_room"
        hx-include="closest form"
        hx-swap="outerHTML"
        hx-target="#login-stpl"
        class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline"
        type="button">
        Create Room
      </button>
      <a hx-post="/pages/" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800" href="#">
        Join Room
      </a>
    </div>
  </form>
  <p class="text-center text-gray-500 text-xs">
    &copy;2026 RF Corp All rights reserved.
  </p>
</div>
